<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class ="container">
    <h1>Login</h1>
    <p>Log in to manage your shortened URLs</p>

    <form action="/user/login" method ="post">
      <label for ="email">Email</label>
      <input 
      type ="email",
      id ="email",
      name ="email",
      required
      >
      <label for ="password">Password</label>
      <input 
      type ="password",
      id ="password",
      name ="password",
      required
      >

      <button type ="submit">Login</button>
    </form>
    <p>New User ? <a href="/user/register">Create an account</a></p>
  </div>
  
</body>
</html>